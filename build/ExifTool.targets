<Project>

  <!--
    Downloads a pinned ExifTool build, verifies its SHA-256 and copies it to the output as exiftool\exiftool.exe
    (plus its exiftool_files\ runtime). Imported by PictureIt.Infrastructure; copy-to-output items flow on to every
    project that references it (the app and the tests).

    To upgrade: change the version, and take the "SHA2-256(exiftool-<version>_64.zip)" line from
    https://exiftool.org/checksums.txt.
  -->
  <PropertyGroup>
    <ExifToolVersion>13.59</ExifToolVersion>
    <ExifToolSha256>44b512b25af500724ba579d0a53c8fc5851628b692dd5e5d94ae4a15c2cba9ec</ExifToolSha256>
    <ExifToolPackageName>exiftool-$(ExifToolVersion)_64</ExifToolPackageName>
    <!-- SourceForge is ExifTool's official mirror and, unlike exiftool.org, keeps older versions. -->
    <ExifToolUrl>https://sourceforge.net/projects/exiftool/files/$(ExifToolPackageName).zip/download</ExifToolUrl>
    <ExifToolCacheDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'tools', 'exiftool', '$(ExifToolVersion)'))</ExifToolCacheDir>
    <ExifToolZip>$(ExifToolCacheDir)$(ExifToolPackageName).zip</ExifToolZip>
    <ExifToolHome>$(ExifToolCacheDir)$(ExifToolPackageName)\</ExifToolHome>
  </PropertyGroup>

  <Target Name="AcquireExifTool" Condition="!Exists('$(ExifToolHome)exiftool.exe')">
    <DownloadFile SourceUrl="$(ExifToolUrl)"
                  DestinationFolder="$(ExifToolCacheDir)"
                  DestinationFileName="$(ExifToolPackageName).zip"
                  Retries="3" />

    <GetFileHash Files="$(ExifToolZip)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_ExifToolActualSha256" />
    </GetFileHash>

    <Delete Files="$(ExifToolZip)"
            Condition="'$(_ExifToolActualSha256.ToLowerInvariant())' != '$(ExifToolSha256.ToLowerInvariant())'" />
    <Error Condition="'$(_ExifToolActualSha256.ToLowerInvariant())' != '$(ExifToolSha256.ToLowerInvariant())'"
           Text="ExifTool download failed verification: expected SHA-256 $(ExifToolSha256), got $(_ExifToolActualSha256)." />

    <Unzip SourceFiles="$(ExifToolZip)" DestinationFolder="$(ExifToolCacheDir)" />

    <!-- The Windows build ships as "exiftool(-k).exe", which pauses for a keypress; the plain name runs normally. -->
    <Copy SourceFiles="$(ExifToolHome)exiftool(-k).exe" DestinationFiles="$(ExifToolHome)exiftool.exe" />
    <Delete Files="$(ExifToolZip)" />
  </Target>

  <!--
    Items are added inside a target because the files don't exist until AcquireExifTool has run. Inside a target,
    unqualified %(...) metadata batches over the *existing* None items, so the files are staged in their own item
    type first and the Link uses qualified metadata.
  -->
  <Target Name="IncludeExifToolInOutput" DependsOnTargets="AcquireExifTool" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_ExifToolRuntimeFile Include="$(ExifToolHome)exiftool_files\**\*" />
      <None Include="$(ExifToolHome)exiftool.exe"
            Link="exiftool\exiftool.exe"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
      <None Include="@(_ExifToolRuntimeFile)"
            Link="exiftool\exiftool_files\%(_ExifToolRuntimeFile.RecursiveDir)%(_ExifToolRuntimeFile.Filename)%(_ExifToolRuntimeFile.Extension)"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
