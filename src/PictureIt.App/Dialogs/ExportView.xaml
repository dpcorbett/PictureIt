<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PictureIt.App.Dialogs.ExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Spacing="12" Width="440">
    <TextBlock Text="{x:Bind Tool.PhotoCountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <RadioButtons Header="Format" SelectedIndex="{x:Bind Tool.FormatIndex, Mode=TwoWay}">
      <x:String>CSV (opens in Excel)</x:String>
      <x:String>JSON</x:String>
    </RadioButtons>
    <RadioButtons Header="Include" SelectedIndex="{x:Bind Tool.FieldsIndex, Mode=TwoWay}">
      <x:String>Common fields (title, description, keywords, rights, place)</x:String>
      <x:String>Every tag</x:String>
    </RadioButtons>
    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
               Text="To bulk-edit in a spreadsheet: export, change the cells you want, save, then choose Organise › Import metadata. Only cells that differ from the photo are written, and blank cells change nothing." />
  </StackPanel>
</UserControl>
