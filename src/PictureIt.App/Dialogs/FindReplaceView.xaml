<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PictureIt.App.Dialogs.FindReplaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Spacing="12" Width="440">
    <TextBlock Text="{x:Bind Tool.PhotoCountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <TextBox Header="Find" Text="{x:Bind Tool.Find, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBox Header="Replace with" Text="{x:Bind Tool.Replace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PlaceholderText="Leave empty to delete the text" />
    <StackPanel>
      <CheckBox Content="Match case" IsChecked="{x:Bind Tool.MatchCase, Mode=TwoWay}" />
      <CheckBox Content="Use a regular expression" IsChecked="{x:Bind Tool.UseRegex, Mode=TwoWay}" />
      <CheckBox IsChecked="{x:Bind Tool.AllTextTags, Mode=TwoWay}">
        <TextBlock TextWrapping="Wrap" Text="Search every text tag, not just the common fields (title, description, keywords, rights, place)" />
      </CheckBox>
    </StackPanel>
    <TextBlock Text="{x:Bind Tool.Error, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
