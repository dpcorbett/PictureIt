<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PictureIt.App.Dialogs.RemoveMetadataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Spacing="12" Width="460">
    <TextBlock Text="{x:Bind Tool.PhotoCountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

    <StackPanel>
      <CheckBox Content="GPS location" IsChecked="{x:Bind Tool.GpsLocation, Mode=TwoWay}" IsEnabled="{x:Bind Tool.PartialOptionsEnabled, Mode=OneWay}" />
      <CheckBox Content="Place names (city, state, country, sublocation)" IsChecked="{x:Bind Tool.PlaceNames, Mode=TwoWay}"
                IsEnabled="{x:Bind Tool.PartialOptionsEnabled, Mode=OneWay}" />
      <CheckBox IsChecked="{x:Bind Tool.CameraIdentifiers, Mode=TwoWay}" IsEnabled="{x:Bind Tool.PartialOptionsEnabled, Mode=OneWay}">
        <TextBlock TextWrapping="Wrap" Text="Camera identifiers (serial numbers, owner name and the maker's private data)" />
      </CheckBox>
      <CheckBox IsChecked="{x:Bind Tool.Everything, Mode=TwoWay}">
        <TextBlock TextWrapping="Wrap" Text="Everything (keeps only orientation and colour profile, which the photo needs to display correctly)" />
      </CheckBox>
    </StackPanel>

    <StackPanel Spacing="6">
      <ToggleSwitch Header="Where" OffContent="Change the original photos" OnContent="Save cleaned copies, leave originals alone"
                    IsOn="{x:Bind Tool.SaveAsCopies, Mode=TwoWay}" />
      <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Tool.SaveAsCopies, Mode=OneWay}">
        <Button Content="Choose folder…" Command="{x:Bind Tool.ChooseCopyFolderCommand}" />
        <TextBlock Text="{x:Bind Tool.CopyFolder, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
      </StackPanel>
    </StackPanel>

    <TextBlock Text="{x:Bind Tool.Error, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
