<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PictureIt.App.Dialogs.FilePlanPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PictureIt.App.Views"
    xmlns:tools="using:PictureIt.Presentation.ViewModels.Tools">

  <!-- The live preview shared by Rename and Sort: old name → new name, with notes. -->
  <StackPanel Spacing="8">
    <TextBlock Text="{x:Bind Tool.Summary, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
    <ListView ItemsSource="{x:Bind Tool.Rows, Mode=OneWay}" SelectionMode="None" Height="{x:Bind ListHeight}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="0,4"
              AutomationProperties.Name="Preview">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="tools:FilePlanRow">
          <StackPanel Padding="0,4" Opacity="{x:Bind views:Ui.DimIf(IsUnchanged)}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind From}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind From}" />
              <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock Grid.Column="2" Text="{x:Bind To}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind To}"
                         Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Grid>
            <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind HasNote}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <TextBlock Text="{x:Bind Tool.Error, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
