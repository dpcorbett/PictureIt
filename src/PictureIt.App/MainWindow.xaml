<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PictureIt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PictureIt">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Custom title bar: drag area with the app name; caption buttons are drawn by the system on the right. -->
    <Grid x:Name="AppTitleBar" Height="40" Padding="16,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE91B;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock Text="PictureIt" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <NavigationView
        x:Name="Navigation"
        Grid.Row="1"
        PaneDisplayMode="LeftCompact"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        IsPaneToggleButtonVisible="False"
        SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="LibraryItem" Content="Library" Tag="library">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8B9;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
