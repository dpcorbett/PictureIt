<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PictureIt.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Padding="32,8,32,32" Spacing="4">
      <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

      <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
      <Grid Padding="16" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE790;" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="App theme" />
          <TextBlock Text="Follow Windows, or always use light or dark." Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="160" VerticalAlignment="Center" SelectionChanged="OnThemeSelectionChanged">
          <ComboBoxItem Content="Use system setting" Tag="System" />
          <ComboBoxItem Content="Light" Tag="Light" />
          <ComboBoxItem Content="Dark" Tag="Dark" />
        </ComboBox>
      </Grid>

      <TextBlock Text="Safety" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,4" />
      <Grid Padding="16" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE8F1;" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Backups" />
          <TextBlock Text="Every file is copied here before it's changed, so edits can be undone."
                     Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind ViewModel.BackupFolder}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="2" Content="Open folder" VerticalAlignment="Center" Click="OnOpenBackupFolder" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
