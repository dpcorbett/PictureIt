<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PictureIt.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PictureIt.App.Views"
    xmlns:vm="using:PictureIt.Presentation.ViewModels">

  <Grid Padding="32,8,32,0" RowSpacing="8">
    <Grid.ColumnDefinitions>
      <!-- Full width up to a comfortable reading width, left-aligned. -->
      <ColumnDefinition Width="*" MaxWidth="960" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" />
    <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"
               Text="Every save is listed here. Undo puts the photos back exactly as they were, from the backup taken before the change." />

    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Records}" SelectionMode="None">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:BatchRecordViewModel">
          <Grid Padding="16,12" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Bind Description}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
              <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="{x:Bind When}" />
                <Run Text=" · " />
                <Run Text="{x:Bind Summary}" />
              </TextBlock>
              <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                         Visibility="{x:Bind views:Ui.VisibleIfText(Status)}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Visibility="{x:Bind CanUndo}" Click="OnUndoClick"
                    AutomationProperties.Name="{x:Bind UndoLabel}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                <TextBlock Text="Undo" />
              </StackPanel>
            </Button>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBlock Grid.Row="2" Text="Nothing yet. Changes you save will appear here." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
  </Grid>
</Page>
